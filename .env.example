

# --- PostgreSQL (base de datos de OpenProject) ---
POSTGRES_USER=openproject
POSTGRES_PASSWORD=cambie-esta-contrasena

# --- OpenProject ---
# Clave secreta larga y aleatoria. Puede generarla con:
#   openssl rand -hex 64
OPENPROJECT_SECRET_KEY_BASE=genere-una-clave-larga-y-aleatoria-aqui

# --- n8n ---
# Clave de cifrado interna de n8n. Puede generarla con:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=genere-una-clave-aleatoria-aqui

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=cambie-esta-contrasena

# --- Usuario administrador de OpenProject (uso manual/documentación) ---
OPENPROJECT_ADMIN_USER=admin
OPENPROJECT_ADMIN_PASSWORD=cambie-esta-contrasena
OPENPROJECT_ADMIN_MAIL=admin@ejemplo.com

# --- Token de API de OpenProject (se genera desde la interfaz, paso 9 del manual) ---
OPENPROJECT_API_TOKEN=

# --- Cuenta "owner" de n8n ---
N8N_OWNER_EMAIL=owner@ejemplo.com
N8N_OWNER_PASSWORD=cambie-esta-contrasena

# --- SMTP (envío de correos, usado por OpenProject para notificaciones) ---
#SMTP_PASSWORD debe ser una "contraseña de aplicación"(como se menciono en la case)
SMTP_USER_NAME=cuenta@gmail.com
SMTP_PASSWORD=contrasena-de-aplicacion-de-16-caracteres
